LAMMPS (22 Jul 2025)
KOKKOS mode with Kokkos version 4.6.2 is enabled
  will use up to 4 GPU(s) per node
WARNING: When using a single thread, the Kokkos Serial backend (i.e. Makefile.kokkos_mpi_only) gives better performance than the OpenMP backend (src/KOKKOS/kokkos.cpp:221)
WARNING: Turning off GPU-aware MPI since it is not detected, use '-pk kokkos gpu/aware on' to override (src/KOKKOS/kokkos.cpp:310)
  using 1 OpenMP thread(s) per MPI task
package kokkos
package kokkos
# Basic setup for LAMMPS simulation

units           metal
dimension       3
boundary        p p s
atom_style      atomic

########################## Initialization ############################

# Directory Setting
variable        dir string "runs"
# shell           mkdir ${dir}

# Sample information
read_data       /ocean/projects/mat250018p/lvlvmei/Shock/read_data/nanoindentation.lmp
Reading data file ...
  orthogonal box = (0 0 0) to (178.6 178.6 178.6)
  1 by 2 by 2 MPI processor grid
  reading atoms ...
  1000000 atoms
  read_data CPU = 2.147 seconds
variable        depth_adjust    equal   4           # initial gap between the indenter and the sample
variable        cube_size       equal   lx          # Cube size in Angstrom
variable        timestep        equal 0.001         # Time step in ps
variable        seed        equal   20110723        ### Random seed

# Indentation information
variable        indent_R equal 160.0                 ### Change here
variable        indent_K equal 10000.0               ### Change here (eV/Angstrom^3)
variable        indent_depth equal 80.0             ### Change here
variable        equil_step equal 10000
variable        loadstep equal 160000                ### Change here
variable        indent_rate equal ${indent_depth}/${loadstep}/${timestep} # Indentation rate in Angstrom/ps
variable        indent_rate equal 80/${loadstep}/${timestep} 
variable        indent_rate equal 80/160000/${timestep} 
variable        indent_rate equal 80/160000/0.001 
variable        temperature equal 300.0             ### Change here

# Dumping settings
variable        dumpfreq equal 2000
variable        detail_start equal 10000
variable        detail_end equal 10000
variable        detail_freq equal 20

# Define pair potential (Tersoff potential for C)
pair_style snap/kk
pair_coeff * * C_SNAP_2021.10.15.quadratic.snapcoeff C_SNAP_2021.10.15.quadratic.snapparam C
SNAP Element = C, Radius 0.5, Weight 1
SNAP keyword rcutfac 2.7
SNAP keyword twojmax 8
SNAP keyword rfac0 0.99363
SNAP keyword rmin0 0.0
SNAP keyword bzeroflag 0
SNAP keyword quadraticflag 1
neigh_modify delay 0 every 1 check yes

# Minimization
thermo          100
# minimize        1e-9 1e-9 1000000 10000000

# write_dump      all atom        relaxed.dump.gz

########################## Equilibration ############################

# Note that the indenter is operated from -z to +z at the origin 0 0 0
# Define the bottom atom layer, fix later in the indentation simulation
variable        cube_ztop   equal ${cube_size}-${depth_adjust}
variable        cube_ztop   equal 178.6-${depth_adjust}
variable        cube_ztop   equal 178.6-4
region          fixed_region block INF INF INF INF ${cube_ztop} INF units box
region          fixed_region block INF INF INF INF 174.6 INF units box
group           bottom region fixed_region
20000 atoms in group bottom
group           mobile subtract all bottom
980000 atoms in group mobile

fix             bottom bottom setforce 0.0 0.0 0.0
velocity        bottom set  0.0 0.0 0.0
variable        bottom_rxn  equal f_bottom[3]/(lx*ly)

# Equilibrate the sample (with indenter)
reset_timestep  0
timestep        ${timestep}
timestep        0.001
compute         new         mobile temp

thermo          100
thermo_style    custom step temp etotal press vol pxx pyy pzz

# raise the temperature to target
velocity        mobile         create ${temperature} ${seed} temp new
velocity        mobile         create 300 ${seed} temp new
velocity        mobile         create 300 20110723 temp new

# equilibrate the sample
# fix             ensemble    all npt temp ${temperature} ${temperature} 0.1 x 0.0 0.0 1.0 y 0.0 0.0 1.0
fix             ensemble    all nvt temp ${temperature} ${temperature} 0.1
fix             ensemble    all nvt temp 300 ${temperature} 0.1
fix             ensemble    all nvt temp 300 300 0.1
# fix             fix_drift   all momentum 1 linear 1 1 1 angular rescale
run             ${equil_step}
run             10000
ERROR: Pair style SNAP requires newton pair on (src/KOKKOS/pair_snap_kokkos_impl.h:73)
Last input line: run ${equil_step}
